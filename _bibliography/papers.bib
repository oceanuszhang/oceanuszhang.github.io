@inproceedings{zhang2025disco,
  abbr        = {IEEE ICIP},
  title       = {{DISCO}: A Diffusion Model for Spatial Transcriptomics Data Completion},
  author      = {Zhang, Zhuoyang and others},
  booktitle   = {IEEE International Conference on Image Processing},
  year        = {2025},
  month       = {August},
  note        = {Accepted},
  selected    = {true},
  bibtex_show = {true},
  html        = {https://pmc.ncbi.nlm.nih.gov/articles/PMC12407492/},
  abstract    = {We present DISCO, a diffusion model for spatial transcriptomics data completion that addresses missing gene expression measurements in spatial sequencing experiments. Our approach leverages the generative capabilities of diffusion models to impute missing spatial gene expression values while preserving the underlying biological structure.}
